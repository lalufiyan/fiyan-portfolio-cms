# Environment
#
# Local development may omit DATABASE_URL to render static fallback content.
# Production deployments require a real database and media storage.
#
# Validation in payload.config.ts:
# - production runtime and builds require DATABASE_URL, PAYLOAD_SECRET,
#   NEXT_PUBLIC_SITE_URL and all R2_* variables.
# - CI sets CMS_STATIC_BUILD=1 for a credential-free build only; never use this
#   opt-in in deployed environments.
# - local development with DATABASE_URL but no R2 stores media on local disk.
# - PAYLOAD_PREVIEW_SECRET enables production live preview; without it the
#   preview endpoint is unavailable. CRON_SECRET is required only for cron jobs.

# Database
# Local Docker/Postgres example:
# DATABASE_URL=postgres://payload:payload@127.0.0.1:5432/fiyan_portfolio
#
# Neon/Vercel production example:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=verify-full
DATABASE_URL=

# Payload
# Required for production deployments.
# Generate a strong value for production:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=

# Optional; required if production draft/live preview is used.
PAYLOAD_PREVIEW_SECRET=

# Optional Payload jobs/scheduled publish bearer token for cron execution.
CRON_SECRET=

# Production site URL used for canonical and social metadata.
NEXT_PUBLIC_SITE_URL=

# Cloudflare R2 media storage
# All four credentials plus R2_PUBLIC_URL are required for production.
# Partial local configuration keeps media on local disk with a warning.
#
# R2_BUCKET is the bucket name only, for example: fiyan-portfolio-media
R2_BUCKET=

# R2_ENDPOINT is the S3-compatible endpoint, usually:
# https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_ENDPOINT=

# R2 access keys from Cloudflare R2 > Manage R2 API Tokens.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Public URL used by the frontend for uploaded media.
# Use your R2 custom/public domain or a Cloudflare Worker that serves the bucket, for example:
# https://media.example.com
# Only this host is allowed to serve optimized images through next/image.
R2_PUBLIC_URL=
