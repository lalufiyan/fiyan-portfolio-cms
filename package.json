{
  "name": "fiyan-portfolio-cms",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "build:vercel": "if [ \"$VERCEL_ENV\" = \"production\" ]; then pnpm run payload:migrate; fi && pnpm run build",
    "dev": "next dev",
    "lint": "eslint .",
    "payload": "cross-env PAYLOAD_CONFIG_PATH=payload.config.ts payload",
    "payload:migrate": "pnpm payload migrate",
    "payload:migrate:create": "pnpm payload migrate:create",
    "payload:seed": "cross-env PAYLOAD_CONFIG_PATH=payload.config.ts tsx scripts/seed-payload.ts",
    "payload:types": "pnpm payload generate:types",
    "start": "next start",
    "test:db": "tsx tests/db/rehearse.ts",
    "test:e2e": "playwright test",
    "test:smoke": "tsx tests/smoke/run.ts"
  },
  "dependencies": {
    "@emotion/is-prop-valid": "^1.4.0",
    "@payloadcms/admin-bar": "3.84.1",
    "@payloadcms/db-postgres": "^3.84.1",
    "@payloadcms/live-preview-react": "3.84.1",
    "@payloadcms/next": "^3.84.1",
    "@payloadcms/plugin-redirects": "3.84.1",
    "@payloadcms/plugin-seo": "3.84.1",
    "@payloadcms/richtext-lexical": "3.84.1",
    "@payloadcms/storage-s3": "^3.84.1",
    "@payloadcms/ui": "3.84.1",
    "clsx": "^2.1.1",
    "cross-env": "^10.1.0",
    "framer-motion": "^12.40.0",
    "gsap": "^3.15.0",
    "lucide-react": "^0.454.0",
    "next": "16.3.8",
    "payload": "^3.84.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "sharp": "^0.34.5",
    "tailwind-merge": "^2.5.5",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^22",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.3.8",
    "postcss": "^8.5",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
