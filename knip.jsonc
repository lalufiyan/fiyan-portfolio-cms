{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  // The smoke runner discovers cases via readdirSync and resolves module stubs
  // through its own TSX_TSCONFIG_PATH at runtime; static import walking cannot.
  "entry": ["tests/smoke/*.{ts,tsx}"],
  "ignore": ["tests/smoke/stubs/**"]
}
